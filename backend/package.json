{
  "name": "@car-tracker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/db.js",
  "types": "dist/db.d.ts",
  "scripts": {
    "dev": "tsc --noEmit --watch -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
